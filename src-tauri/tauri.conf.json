{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DevToolbox",
  "version": "0.1.0",
  "identifier": "com.devtoolbox.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevToolbox",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Open-source developer utilities toolbox",
    "longDescription": "DevToolbox is a free, open-source collection of developer utilities. Everything runs locally — your data never leaves your machine.",
    "copyright": "DevToolbox Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
